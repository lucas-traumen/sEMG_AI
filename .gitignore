# --- environment ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- raw data: never committed, never modified (AGENT.md rule 6) ---
data/raw/
data/interim/
data/processed/

# --- large derived artifacts ---
# The manifests are hashed and regenerated by Stage A0/A1; window parquets are
# ~140k rows of indices and are reproducible, so they stay out of git and are
# identified by manifest_sha256.txt instead.
data/manifest/*.parquet
checkpoints/
reports/
results/kaggle/

# --- secrets: never in the repo ---
.env
*.pem
kaggle.json
